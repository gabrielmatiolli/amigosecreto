# String de conexão do PostgreSQL (ex.: Neon, via Vercel > Storage). Use a versão "pooled".
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require
# Senha do painel /admin
ADMIN_PASSWORD=troque-esta-senha
# Segredo para assinar os cookies de sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
